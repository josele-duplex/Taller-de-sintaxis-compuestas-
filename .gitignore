node_modules/
.DS_Store
Thumbs.db

# Config local de Claude Code (permisos, servidor de preview, worktrees):
# no versionar. EXCEPCIÓN: .claude/skills/ sí se versiona — es el skill
# "taller-sintaxis" (terminología NGLE, schema de datos, convenciones de
# despliegue). Antes vivía solo en la caché de sesión de otra app y se
# perdía; ahora vive en el repo para que persista entre máquinas y sesiones.
.claude/*
!.claude/skills/

# Visual Studio (metadatos locales del IDE, no del proyecto)
.vs/

# Archivos de bloqueo de LibreOffice/Word al tener un documento abierto
.~lock.*#

# TSV exportados del Sheet para validar (datos en bruto, no versionar).
# La carpeta y su LEEME.md sí se versionan; los .tsv/.csv no.
banco_export/*.tsv
banco_export/*.csv

# Documentos generados por los build-*.js de la serie "estrategia web"
# (sep-2026). Se versiona el generador, no su salida: cualquiera de estos
# se rehace con `node build-<lo-que-sea>.js`. Ojo: los .docx antiguos de la
# raíz SÍ están versionados por historial, aunque algunos también sean
# regenerables; si algún día se normaliza, se hace en un commit aparte.
Brief_Tecnico_SEO_Taller_Sintaxis.docx
Nota_Tecnica_Alojamiento_Taller_Sintaxis.docx
Informe_Version_Light_Taller_Sintaxis.pdf
Seleccion_Simple_Light.csv
Seleccion_Compuestas_Light.csv
Seleccion_Morfologia_Light.csv
